<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Never rewrite static asset file extensions to index.html
  RewriteCond %{REQUEST_URI} \.(js|css|png|jpg|jpeg|gif|ico|svg|json|woff2?|ttf|eot)$ [NC]
  RewriteRule ^ - [L]

  # 2. Never rewrite /api/ requests
  RewriteRule ^api/ - [L]

  # 3. Skip rewrite if requested file or directory exists
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 4. Route all React SPA client routes to index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Force correct MIME types for Javascript and CSS
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType image/png .png
  AddType image/jpeg .jpg .jpeg
</IfModule>

# Enable Gzip Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Security Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
</IfModule>
